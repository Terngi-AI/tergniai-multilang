# Copy this file to .env and fill in your own values. Never commit .env.

# ---------------------------------------------------------------------------
# Providers. You need at least one. Every provider accepts several keys
# (comma-separated) which are rotated; rejected or rate-limited keys are
# skipped for a while. Several models can be listed and are tried in order.
# ---------------------------------------------------------------------------

# Azure Translator (optional) — https://learn.microsoft.com/azure/ai-services/translator/
AZURE_TRANSLATOR_KEYS=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_LOCATION=global

# LLM providers, in priority order. Built-in: groq, openrouter, together, cerebras,
# huggingface, openai, ollama, morena. Any other name works with <NAME>_BASE_URL set
# to an OpenAI-compatible API.
LLM_PROVIDERS=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# OpenRouter (optional; add "openrouter" to LLM_PROVIDERS) — https://openrouter.ai/keys
# OPENROUTER_API_KEYS=
# OPENROUTER_MODELS=

# MORENA by Vambo AI (optional, free, runs locally; add "morena" to LLM_PROVIDERS)
# See docs/MORENA.md or run: docker compose --profile morena up
# MORENA_BASE_URL=http://localhost:8080

# Which providers handle each task, in order ("azure" or an LLM provider name).
# Defaults: chat = LLM_PROVIDERS; translation = azure + LLM_PROVIDERS;
#           detection = azure + LLM_PROVIDERS except morena
# CHAT_PROVIDERS=groq
# TRANSLATION_PROVIDERS=azure,morena,groq
# DETECTION_PROVIDERS=azure,groq

# Agent (/v1/agent): providers that run it (must support tool calling) and its limits
# AGENT_PROVIDERS=groq
AGENT_MAX_STEPS=6
# Max tokens generated per agent model call (bounds the cost of a long multi-step request)
AGENT_MAX_TOKENS=1500

# Shared storage (optional). With Redis, the cache, rate limits and chat conversations are
# shared by every replica and survive restarts; without it they live in process memory.
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=terngi:
REDIS_TIMEOUT=2

# Chat memory for /v1/chat
CONVERSATION_TTL_SECONDS=86400
# Maximum conversations kept; the least recently written are evicted first
CONVERSATION_MAX_ITEMS=10000
CONVERSATION_MAX_MESSAGES=40
# Maximum characters of history kept per conversation; the oldest turns are dropped first
CONVERSATION_MAX_CHARS=20000

# How long to skip a provider whose server can't be reached (e.g. a local MORENA that's off)
PROVIDER_DOWN_COOLDOWN_SECONDS=30

# When every model is rate-limited, wait up to this many seconds for one to free up
RATE_LIMIT_MAX_WAIT_SECONDS=10

# Restrict a provider to certain languages (MORENA defaults to its own 14)
# OPENROUTER_LANGUAGES=en,fr,ar

# Seconds to skip a key after a 429 (when no Retry-After is sent) or a 401/403
KEY_COOLDOWN_SECONDS=60
INVALID_KEY_COOLDOWN_SECONDS=3600

# Client authentication — comma-separated keys clients send as X-API-Key.
# Leave empty to disable auth (local development only!).
API_KEYS=

# Optional: dedicated bearer token for the Prometheus /metrics endpoint, so the
# monitoring stack does not need an API key. Sent as "Authorization: Bearer <token>".
# METRICS_TOKEN=
# Keying secret for personal identifiers (HMAC-SHA256): WhatsApp phone numbers and
# IP-based conversation owners. The app refuses to start without it. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
HASH_SECRET=

# WhatsApp bot (optional) — see docs/WHATSAPP.md. All four are needed to turn it on.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Facts the bot answers from, and a greeting for first-time users
# WHATSAPP_CONTEXT=
# WHATSAPP_WELCOME=

# Optional tuning
RATE_LIMIT_PER_MINUTE=60
# Failed API-key attempts allowed per IP per minute (0 disables). Wrong or missing keys
# are rate-limited separately from authenticated traffic.
AUTH_FAILURES_PER_MINUTE=10
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=1000
# Who shares the translation cache: "key" = one cache per API key (callers can't probe
# each other's translations via cache timing), "global" = one shared cache (more quota
# reuse). Default: "key" when API_KEYS is set, otherwise "global".
# CACHE_SCOPE=key
# Opt-in feedback JSONL file; with REDIS_URL set, records go to Redis instead
FEEDBACK_FILE=feedback.jsonl
# Maximum records kept (Redis drops the oldest; the JSONL file refuses new ones; 0 = no cap)
FEEDBACK_MAX_RECORDS=10000
MAX_BATCH_SIZE=25
MAX_BATCH_CHARACTERS=50000
# Largest request body in bytes (bigger requests get 413)
MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT=30
# Whole-request budgets (seconds). Retries, provider fallbacks and agent steps share them.
# 0 disables the deadline and the upstream attempt cap.
REQUEST_DEADLINE_SECONDS=55
STREAM_DEADLINE_SECONDS=120
# Streaming chat: at most one SSE keep-alive comment per STREAM_HEARTBEAT_SECONDS, so
# idle proxies don't cut long streams (0 disables); STREAM_QUEUE_MAXSIZE bounds the
# pending events per stream - a slow client pauses generation instead of growing memory
# (0 removes the bound)
STREAM_HEARTBEAT_SECONDS=15
STREAM_QUEUE_MAXSIZE=256
# Maximum upstream requests per API request, retries and fallbacks included (0 disables)
REQUEST_MAX_UPSTREAM_ATTEMPTS=20
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY=0.5
UPSTREAM_RETRY_MAX_DELAY=10
MAX_CONTENT_LENGTH=5000
MAX_MEMORY_MESSAGES=20
LOG_LEVEL=INFO
# Comma-separated, e.g. https://app.example.com,http://localhost:3000
CORS_ORIGINS=

# Optional daily request quotas per API key (counted per UTC day; keys not listed are
# unlimited). Only applies when API_KEYS is configured. Example: key1 may send 1000
# requests/day, key2 5000.
# API_KEY_QUOTAS=key1:1000,key2:5000
# How long per-key usage counters are kept (two days covers today and yesterday)
# USAGE_TTL_SECONDS=172800
# USAGE_MAX_ITEMS=10000

# Reverse proxy IPs/CIDRs allowed to set X-Forwarded-For (uvicorn). The default trusts
# loopback only. Behind ALB, Nginx or a Docker proxy, set this to the proxy address or
# subnet; clients behind that proxy then get distinct rate-limit and conversation buckets.
# Never use * when the API port is reachable directly from the internet.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
